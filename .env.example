# ── Gmail se email bhejne ke liye (Nodemailer) ──────────────────
# Gmail me 2-Step Verification ON karo, phir App Password banao:
# https://myaccount.google.com/apppasswords
# App Password yahan SMTP_PASS me daalo (normal Gmail password kaam nahi karega).

SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=aapki@gmail.com
SMTP_PASS=yahan-app-password-dalo
NOTIFY_EMAIL=aapki@gmail.com
